{
  "name": "gennex-color",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsdown && bun scripts/build-assets.ts",
    "smoke": "bun run build && bun scripts/smoke.ts && tsc --noEmit -p tsconfig.smoke.json",
    "smoke:example": "bun scripts/smoke-example.ts",
    "smoke:clean": "bun scripts/smoke-clean.ts",
    "perf:example": "bun scripts/perf-example.ts"
  },
  "dependencies": {
    "culori": "4.0.2"
  },
  "devDependencies": {
    "@radix-ui/colors": "3.0.0",
    "@types/bun": "^1.4.4",
    "@types/culori": "^4.0.1",
    "happy-dom": "^21.0.4",
    "tsdown": "0.23.5",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./css/*.css": "./dist/css/*.css",
    "./tokens/*.json": "./dist/tokens/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "license": "MIT"
}
